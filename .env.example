# Anthropic API 키 (https://console.anthropic.com). 코드에 넣지 말고 환경변수로만 주입한다.
ANTHROPIC_API_KEY=sk-ant-...

# 튜터 모델. 기본 claude-opus-5. 원가를 더 낮추려면 claude-haiku-4-5 (docs/cost-model.md 참고)
# TUTOR_MODEL=claude-opus-5

# AI 원가 표시용 환율 (원/달러)
# KRW_PER_USD=1400

# ---- 꾸그 진입(핸드오프) ----
# 꾸그 서버와 공유하는 서명 비밀키 (16자 이상). 꾸그 [시작하기]가 만드는 토큰을 이 키로 검증한다. docs/entry-flow.md
# GGUGE_HANDOFF_SECRET=change-me-to-a-long-random-secret
# 방문자 쿠키 서명 키 (없으면 GGUGE_HANDOFF_SECRET 사용)
# COOKIE_SECRET=
# 1단계 베타용 초대 코드. "코드:부여할 분" 을 쉼표로 나열
# INVITE_CODES=GGUGE-BETA-01:60,GGUGE-BETA-02:120
# 1 이면 홈에서 바로 시작 불가, 꾸그 토큰이나 초대 코드로만 진입
# REQUIRE_ENTRY=0
